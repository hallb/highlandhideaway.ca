{{- /*
    Copy of themes/DoIt/layouts/sitemap.xml with one added filter: taxonomy and
    term pages are excluded. They are auto-generated navigation, they carry the
    noindex set in partials/head/meta.html, and listing pages we ask Google not
    to index wastes the crawl budget of a small site. Diff against the theme's
    version after a theme update; see ISS-5.
*/ -}}
<urlset
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:xhtml="http://www.w3.org/1999/xhtml"
    >
    {{- $pages := where .Data.Pages "Section" "!=" "gallery" -}}
    {{- $pages = where $pages "Kind" "not in" (slice "taxonomy" "term") -}}
    {{- range $pages -}}
        <url>
            <loc>
                {{- .Permalink -}}
            </loc>
            {{- if not .Lastmod.IsZero -}}
                <lastmod>
                    {{- .Lastmod.Format "2006-01-02T15:04:05-07:00" -}}
                </lastmod>
            {{- end -}}
            {{- with .Sitemap.ChangeFreq -}}
                <changefreq>
                    {{- . -}}
                </changefreq>
            {{- end -}}

            {{- if ge .Sitemap.Priority 0.0 -}}
                {{- $weeks := div (sub now.Unix .Lastmod.Unix) 604800 -}}
                {{- $priority := sub 1 (div $weeks 10.0 ) -}}
                {{- if ge .Sitemap.Priority $priority -}}
                    <priority>{{ .Sitemap.Priority }}</priority>
                {{- else -}}
                    <priority>{{ $priority }}</priority>
                {{- end -}}
            {{- end -}}

            {{- if .IsTranslated -}}
                {{- range .Translations -}}
                    <xhtml:link
                        rel="alternate"
                        hreflang="{{ .Lang }}"
                        href="{{ .Permalink }}"
                        />
                {{- end -}}
                <xhtml:link
                    rel="alternate"
                    hreflang="{{ .Lang }}"
                    href="{{ .Permalink }}"
                    />
            {{- end -}}
        </url>
    {{- end -}}
</urlset>
